---
import { asset } from '../../lib/cdn';

// The prev/next arrows are present in Figma but only one testimonial's
// content exists in the source (no second slide to cycle to) — rendered as
// shown, not wired into fake carousel logic with nothing to switch between.
---

<section class="flex gap-[138px] items-start justify-center px-[100px] py-[112px] max-lg:flex-col max-lg:items-center max-lg:gap-8 max-lg:px-10 max-lg:py-14 max-md:px-4 max-md:py-16 relative w-full bg-background">
  <div class="h-[465px] w-[392px] max-lg:h-[320px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden">
    <img
      src={asset('images/home/testimonial/photo.webp')}
      alt="Óskar, Hotels Manager"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col items-start justify-between max-lg:justify-start max-lg:gap-14 w-full">
    <p class="font-heading text-h4 text-navy w-full">
      "We were thrilled with Hitels' customized solutions for our website. Their expertise in creating a stylish and intuitive online presence has transformed how we connect with our guests. The new site not only looks superb but also enhances our customer interaction, leading to a notable increase in direct bookings."
    </p>
    <div class="flex gap-5 items-center justify-center w-full">
      <div class="flex flex-1 flex-col gap-1 items-start justify-center">
        <p class="font-heading text-h6 text-navy w-full">Óskar</p>
        <p class="font-body font-normal text-body-md text-gray w-full">Hotels Manager</p>
      </div>
      <div class="flex gap-2.5 items-center shrink-0">
        <button type="button" aria-label="Previous testimonial" class="bg-light-gray flex items-center justify-center rounded-full p-3.5 size-12">
          <img src={asset('images/home/testimonial/arrow-left.svg')} alt="" class="size-5" />
        </button>
        <button type="button" aria-label="Next testimonial" class="bg-light-gray flex items-center justify-center rounded-full p-3.5 size-12">
          <img src={asset('images/home/testimonial/arrow-right.svg')} alt="" class="size-5" />
        </button>
      </div>
    </div>
  </div>
</section>
