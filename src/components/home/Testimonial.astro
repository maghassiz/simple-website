---
import { sanityClient } from 'sanity:client';
import { asset } from '../../lib/cdn';

interface SanityTestimonial {
  name: string;
  role?: string;
  quote: string;
  imageUrl?: string;
  imageAlt?: string;
}

const rows = await sanityClient.fetch<SanityTestimonial[]>(
  `*[_type == "testimonial"] | order(order asc){ name, role, quote, imageUrl, imageAlt }`
);

const testimonials = rows.map((t) => ({
  photo: t.imageUrl ?? asset('images/home/testimonial/photo.webp'),
  alt: t.imageAlt || `${t.name}, ${t.role ?? ''}`,
  quote: t.quote,
  name: t.name,
  role: t.role ?? '',
}));
---

<section class="flex gap-[138px] items-stretch justify-center px-[100px] py-[112px] max-lg:flex-col max-lg:items-center max-lg:gap-8 max-lg:px-10 max-lg:py-14 max-md:px-4 max-md:py-16 relative w-full max-w-[1440px] mx-auto bg-background" data-testimonial-carousel>
  <div data-reveal="fade" class="w-[392px] max-lg:h-[320px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden">
    <div class="testimonial-track flex h-full transition-transform duration-500 ease-in-out">
      {testimonials.map((t) => (
        <img src={t.photo} alt={t.alt} class="w-full h-full object-cover shrink-0" />
      ))}
    </div>
  </div>
  <div data-reveal style="--reveal-delay: 120ms" class="flex flex-1 flex-col items-start gap-[80px] w-full">
    <div class="w-full overflow-hidden">
      <div class="testimonial-track flex transition-transform duration-500 ease-in-out">
        {testimonials.map((t) => (
          <p class="font-heading text-h4 text-navy w-full shrink-0">{t.quote}</p>
        ))}
      </div>
    </div>
    <div class="flex gap-5 items-center justify-center w-full">
      <div class="flex-1 overflow-hidden">
        <div class="testimonial-track flex transition-transform duration-500 ease-in-out">
          {testimonials.map((t) => (
            <div class="flex flex-col gap-1 items-start justify-center w-full shrink-0">
              <p class="font-heading text-h6 text-navy w-full">{t.name}</p>
              <p class="font-body font-normal text-body-md text-gray w-full">{t.role}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="flex gap-2.5 items-center shrink-0">
        <button type="button" aria-label="Previous testimonial" data-direction="-1" class="bg-light-gray flex items-center justify-center rounded-full p-3.5 size-12">
          <img src={asset('images/home/testimonial/arrow-left.svg')} alt="" class="size-5" />
        </button>
        <button type="button" aria-label="Next testimonial" data-direction="1" class="bg-light-gray flex items-center justify-center rounded-full p-3.5 size-12">
          <img src={asset('images/home/testimonial/arrow-right.svg')} alt="" class="size-5" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-testimonial-carousel]').forEach((carousel) => {
    const tracks = carousel.querySelectorAll<HTMLElement>('.testimonial-track');
    const total = tracks[0]?.children.length ?? 0;
    let current = 0;

    function show(index: number) {
      current = (index + total) % total;
      tracks.forEach((track) => {
        track.style.transform = `translateX(-${current * 100}%)`;
      });
    }

    carousel.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        show(current + Number(button.dataset.direction));
      });
    });
  });
</script>
