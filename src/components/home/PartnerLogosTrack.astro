      <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-13a.svg" alt="" class="absolute inset-[10.01%_70.44%_15.01%_3.29%]" />
      <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-13b.svg" alt="" class="absolute inset-[10.01%_3.54%_14.97%_31.94%]" />
    </div>
  </div>

  <div class="h-6 w-[95.368px] overflow-clip relative shrink-0" aria-label="Partner logo">
    <div class="absolute h-[7.579px] right-0 top-[2.53px] w-[37.737px] overflow-clip">
      <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-14-mask.svg" alt="" class="absolute inset-[10.01%_3.54%_14.97%_3.29%]" />
    </div>
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-14a.svg" alt="" class="absolute bottom-[2.95px] h-[9.587px] left-[85.22px] w-[9.133px]" />
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-14b.svg" alt="" class="absolute bottom-[2.95px] h-[9.284px] left-[68.7px] w-[15.575px]" />
