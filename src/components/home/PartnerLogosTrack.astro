    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-14f.svg" alt="" class="absolute bottom-[2.95px] h-[9.284px] left-[24.2px] w-[15.575px]" />
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-14g.svg" alt="" class="absolute bottom-[2.64px] h-[9.891px] left-[13.96px] w-[10.004px]" />
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-14h.svg" alt="" class="absolute bottom-[2.95px] h-[13.566px] left-[1.36px] w-[11.823px]" />
