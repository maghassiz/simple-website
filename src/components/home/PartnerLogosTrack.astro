---
// One full set of partner marks. Rendered twice by PartnerLogos.astro, back
// to back, so a -50% translateX loops seamlessly (each copy is identical,
// so the moment the first scrolls fully offscreen, the second is in the
// exact position the first started in).
---

<div class="flex gap-16 items-center shrink-0" aria-hidden="true">
  <div class="bg-gray h-8 opacity-10 w-px shrink-0"></div>

  <div class="h-[20.769px] w-[115.962px] shrink-0">
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-4.svg" alt="Partner logo" class="h-[17.308px] w-[115.37px]" />
  </div>

  <div class="bg-gray h-8 opacity-10 w-px shrink-0"></div>

  <div class="h-[20.769px] w-[184.327px] shrink-0">
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-5.svg" alt="Partner logo" class="h-[17.308px] w-[184.056px]" />
  </div>

  <div class="h-[34.615px] relative w-[171.635px] shrink-0">
    <div
      class="absolute bg-gray h-[28.846px] left-0 top-[2.88px] w-[172.018px]"
      style="mask-image: url('https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-mask-1.png'); mask-size: 172.018px 28.846px; mask-repeat: no-repeat;"
    ></div>
  </div>

  <div class="inline-grid place-items-start shrink-0">
    <div
      class="bg-gray h-11 w-[59.42px] col-start-1 row-start-1"
      style="mask-image: url('https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-mask-2.png'); mask-size: 59.42px 44px; mask-repeat: no-repeat;"
    ></div>
  </div>

  <div class="h-8 w-24 overflow-clip relative shrink-0">
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-6.svg" alt="Partner logo" class="absolute inset-[6%_2.79%_6%_3.34%]" />
  </div>

  <div class="h-[10px] w-[226.25px] overflow-clip relative shrink-0">
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-7.svg" alt="Partner logo" class="absolute inset-0" />
  </div>

  <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-8.svg" alt="Partner logo" class="h-5 w-[93.181px] shrink-0" />

  <div class="h-6 w-[88px] overflow-clip relative shrink-0">
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-9.svg" alt="Partner logo" class="absolute inset-[4.5%_0_4.52%_0]" />
  </div>

  <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-10.svg" alt="Partner logo" class="h-4 w-32 shrink-0" />

  <div class="flex gap-[10.286px] items-center shrink-0">
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/icon-nav-badge.svg" alt="" class="size-6" />
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/nav-badge-text.svg" alt="" class="h-[10.252px] w-[114.132px]" />
  </div>

  <div class="h-7 w-[45px] overflow-clip relative shrink-0">
    <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-11.svg" alt="Partner logo" class="absolute inset-[6.9%_3.12%_6.18%_3.12%]" />
  </div>

  <div class="flex flex-col gap-2 items-center justify-center px-5 w-[60px] relative shrink-0">
    <div
      class="absolute bg-gray h-8 left-[2.45px] top-0 w-[55.111px]"
      style="mask-image: url('https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/partner-logo-mask-3.png'); mask-size: 55.273px 32px; mask-repeat: no-repeat;"
