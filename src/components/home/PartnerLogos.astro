---
import PartnerLogosTrack from './PartnerLogosTrack.astro';
// "Trusted by 19 partners" logo ticker — an infinite auto-scrolling marquee
// (the Figma layer is literally named "Logo Ticker"). Renders the logo set
// twice back-to-back and animates a -50% translateX; since both copies are
// identical, the loop is seamless — the instant the first set scrolls fully
// offscreen, the second is sitting exactly where the first one started.
---

<div class="flex flex-col gap-1 items-center py-4 relative w-full max-w-[1440px] mx-auto bg-background">
  <p class="font-body font-normal text-navy text-body-md text-center tracking-[-0.16px] w-full">
    Trusted by 19 partners and counting
  </p>
  <div class="backdrop-blur-[25px] px-8 py-6 relative w-full overflow-hidden">
    <div class="partner-ticker-track flex w-max">
      <PartnerLogosTrack />
      <PartnerLogosTrack />
    </div>

    {/* Edge fades — logos scroll out from behind these into view instead of
        popping in/out at the hard clip edge created by overflow-hidden. */}
    <div class="absolute left-0 top-0 h-full w-16 md:w-32 bg-gradient-to-r from-background to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 h-full w-16 md:w-32 bg-gradient-to-l from-background to-transparent z-10 pointer-events-none"></div>

    {/* Fixed at center, above the scrolling track (z-10) — this is a static
        "Built with Framer" badge, not a partner logo, so it doesn't scroll
        with the rest. The gradient fades the scrolling logos to white as
        they pass behind it instead of an abrupt cut. */}
    <div class="absolute left-1/2 -translate-x-1/2 top-0 h-[92px] flex items-center gap-[6.909px] px-20 z-10">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 h-[45px] w-[223px] bg-gradient-to-r from-white/0 via-white to-white/0"></div>
      <div class="relative h-16 w-[62.857px] shrink-0">
        <img src="https://pub-c73b90ae83684de4a5c23aeec6b7b01b.r2.dev/images/home/hero/framer-badge-icon.svg" alt="Framer Partner" class="h-16 w-[62.857px]" />
      </div>
    </div>
  </div>
</div>

<style>
  .partner-ticker-track {
    animation: partner-ticker-scroll 40s linear infinite;
  }

  @keyframes partner-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-ticker-track {
      animation: none;
    }
  }
</style>
