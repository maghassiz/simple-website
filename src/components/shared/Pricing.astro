---
import { asset } from '../../lib/cdn';
import Button from './Button.astro';
import ArrowLink from './ArrowLink.astro';

interface Props {
  showHeading?: boolean;
  showDetailsLink?: boolean;
}

// Home and About Us show this as a mid-page teaser (heading + "View pricing
// details" link out to the dedicated Pricing page). The Pricing page itself
// reuses the same cards but suppresses both, since its own Hero already
// carries the "Pricing" heading and linking to itself would be circular.
const { showHeading = true, showDetailsLink = true } = Astro.props;

const CARDS = [
  {
    title: 'Custom website',
    description: 'A stunning, high-converting digital presence built from scratch to elevate your brand.',
    price: 'ISK 199.900',
    priceSuffix: '/ month',
    features: [
      'Access to web specialists',
      'Custom design',
      'Analytics dashboard',
      'CMS access (2 seats)',
      'External link to booking engine like GODO',
      'Up to 20 beautifully crafted pages',
    ],
    cta: 'Subscribe today',
    theme: 'light',
    icons: ['images/home/pricing/icon-globe.svg'],
  },
  {
    title: 'Booking Engine',
    description: 'Integrate a seamless booking engine into your existing website to maximize revenue.',
    price: '1,8%',
    priceSuffix: '/ direct booking',
    features: [
      'UI matched perfectly to your brand',
      'Frictionless booking flow',
      'Custom add-ons and up-selling',
      'Precision event tracking',
      'Secure backend',
      'Web hosting',
    ],
    cta: 'Get a quote',
    theme: 'light',
    icons: ['images/home/pricing/icon-calendar.svg'],
  },
  {
    title: 'Booking Engine',
    description: 'Combine custom website with a frictionless booking flow to obliterate OTA fees.',
    price: '179.900 + 1,5%',
    priceSuffix: '',
    features: [
      'Everything in Custom website',
      'Everything in Booking engine',
      'Content engine starter pack',
      'Ongoing conversion optimization',
      'Web hosting',
      'Onboarding and setup',
    ],
    cta: 'Get a quote',
    theme: 'dark',
    icons: ['images/home/pricing/icon-globe-card3.svg', 'images/home/pricing/icon-calendar-card3.svg'],
  },
];
---

<section id="pricing" class="flex flex-col gap-16 max-lg:gap-14 max-md:gap-8 items-center px-[100px] py-[112px] max-lg:px-10 max-lg:py-14 max-md:px-4 max-md:py-16 relative w-full max-w-[1440px] mx-auto bg-background">
  {showHeading && (
    <div data-reveal class="flex flex-col gap-4 items-center text-center w-[792px] max-w-full">
      <h2 class="font-heading text-h3 text-navy w-full">Affordable plans for every hotel</h2>
      <p class="font-body font-normal text-body-md text-gray w-full">
        Explore Hitels' flexible pricing plans, designed for hotels of all sizes. Boost direct bookings and online presence with our scalable solutions. Choose your perfect plan today!
      </p>
    </div>
  )}

  <div class="flex gap-8 items-stretch max-lg:flex-col w-full max-w-[1240px]">
    {CARDS.map((card, i) => (
      <div
        data-reveal
        style={`--reveal-delay: ${i * 120}ms`}
        class={`flex flex-1 flex-col gap-16 items-start justify-between p-8 rounded-2xl overflow-hidden ${
          card.theme === 'dark'
            ? 'bg-gradient-to-b from-[#6b5eb5] to-[#170c5a] text-background'
            : 'bg-light-gray text-navy'
        }`}
      >
        <div class="flex flex-col gap-10 items-start w-full">
          <div class="flex flex-col gap-4 items-start w-full">
            <div class="flex items-start justify-between w-full">
              <h3 class="font-heading text-h5 whitespace-nowrap">{card.title}</h3>
              <div class="flex items-center shrink-0">
                {card.icons.map((icon) => (
                  <div class={`flex items-center justify-center rounded-full size-8 p-2 ${card.theme === 'dark' ? 'bg-light-gray border-2 border-[#1e1261] -mr-2 last:mr-0' : 'bg-navy'}`}>
                    <img src={asset(icon)} alt="" class="size-full" />
                  </div>
                ))}
              </div>
            </div>
            <p class={`font-body font-normal text-body-md w-full ${card.theme === 'dark' ? 'text-border' : 'text-gray'}`}>{card.description}</p>
          </div>
          <div class="flex gap-1 items-end w-full">
            <p class="font-heading text-h4 whitespace-nowrap">{card.price}</p>
            {card.priceSuffix && <p class={`font-body font-normal text-body-md ${card.theme === 'dark' ? 'text-border' : 'text-gray'}`}>{card.priceSuffix}</p>}
          </div>
          <div class="flex flex-col gap-4 items-start w-full">
            {card.features.map((feature) => (
              <div class="flex gap-2 items-center w-full">
                <img src={asset(card.theme === 'dark' ? 'images/home/pricing/icon-check-light.svg' : 'images/home/pricing/icon-check-dark.svg')} alt="" class="size-5 shrink-0" />
                <p class="font-body font-normal text-body-md">{feature}</p>
              </div>
            ))}
          </div>
        </div>
        <Button href={card.cta === 'Get a quote' ? '/contact-us' : '#'} label={card.cta} variant={card.theme === 'dark' ? 'secondary' : 'dark'} class="w-full" />
      </div>
    ))}
  </div>

  {showDetailsLink && <ArrowLink href="/pricing" label="View pricing details" />}
</section>
