---
import { asset } from '../../lib/cdn';

interface Props {
  href: string;
  label: string;
  icon?: string;
  variant: 'primary' | 'secondary' | 'dark';
  padding?: string;
  gap?: string;
  iconSize?: string;
  textSize?: string;
  class?: string;
}

const {
  href,
  label,
  icon,
  variant,
  padding = 'pl-4 pr-5 py-3',
  gap = 'gap-3',
  iconSize = 'size-5',
  textSize = 'text-body-md',
  class: className = '',
} = Astro.props;

const VARIANT_STYLES = {
  primary: 'bg-yellow text-navy',
  secondary: 'bg-background text-navy',
  dark: 'bg-navy text-background',
};
---

<a href={href} class={`${VARIANT_STYLES[variant]} flex ${gap} items-center justify-center rounded-lg ${padding} ${className}`}>
  {icon && <img src={asset(icon)} alt="" class={iconSize} />}
  <span class={`font-body font-medium ${textSize} whitespace-nowrap`}>{label}</span>
</a>
