---
import Navigation from '../Navigation';
---

<div class="flex flex-col gap-20 max-lg:gap-14 max-md:gap-10 items-center w-full bg-background">
  <Navigation client:load variant="light" />

  <div data-reveal class="flex flex-col gap-4 items-center text-center px-[100px] max-lg:px-10 max-md:px-4 w-full">
    <h1 class="font-heading text-h1 max-md:text-h3 text-navy max-w-[816px] w-full">Contact us</h1>
    <p class="font-body font-normal text-body-lg max-md:text-body-md text-gray max-w-[792px] w-full">
      We will get to know your team's needs and see how it fits our product and services. Get expert advice from our consultants who can answer any questions you may have.
    </p>
  </div>
</div>
