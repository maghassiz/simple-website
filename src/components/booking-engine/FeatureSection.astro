---
import { asset } from '../../lib/cdn';

interface Props {
  label: string;
  heading: string;
  description: string;
  image: string;
  imageAlt: string;
  imageFirst?: boolean;
}

const { label, heading, description, image, imageAlt, imageFirst = false } = Astro.props;
---

<section class="flex gap-[138px] items-center justify-center px-[100px] py-[112px] max-lg:flex-col max-lg:gap-8 max-lg:px-10 max-lg:py-14 max-md:px-4 max-md:py-16 relative w-full bg-background">
  {imageFirst && (
    <div class="h-[520px] max-lg:h-[380px] max-md:h-[240px] w-[604px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden">
      <img src={asset(image)} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover" />
    </div>
  )}
  <div class="flex flex-col gap-8 items-start w-[498px] max-lg:w-full shrink-0">
    <div class="flex flex-col gap-6 items-start w-full">
      <span class="border border-gray font-body font-medium text-body-sm text-gray rounded px-2.5 pt-0.5 pb-1">{label}</span>
      <h2 class="font-heading text-h3 text-navy w-full">{heading}</h2>
    </div>
    <p class="font-body font-normal text-body-md text-gray w-full">{description}</p>
    <a href="#" class="flex gap-3 items-center justify-center rounded-lg">
      <span class="font-body font-medium text-body-md text-navy whitespace-nowrap">Learn more</span>
      <img src={asset('images/home/pricing/icon-arrow-right.svg')} alt="" class="size-5" />
    </a>
  </div>
  {!imageFirst && (
    <div class="h-[520px] max-lg:h-[380px] max-md:h-[240px] w-[604px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden">
      <img src={asset(image)} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover" />
    </div>
  )}
</section>
