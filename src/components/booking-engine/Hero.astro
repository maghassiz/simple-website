---
import Navigation from '../Navigation';
import Button from '../shared/Button.astro';
import { asset } from '../../lib/cdn';
---

<div class="flex flex-col items-center overflow-hidden relative w-full bg-gradient-to-b from-[#3d2c99] via-[#654aff] via-50% to-background">
  <div aria-hidden class="absolute inset-0 mix-blend-overlay opacity-40 bg-top-left pointer-events-none" style={`background-image: url('${asset('images/home/hero/hero-bg-texture.webp')}'); background-size: 1920px 1080px;`}></div>
  <div aria-hidden class="absolute h-[777px] left-[-323px] top-[366px] w-[2109px] pointer-events-none">
    <img src={asset('images/booking-engine/hero/decorative-blob.svg')} alt="" class="h-full w-full" />
  </div>

  <Navigation client:load />

  <div class="flex flex-col gap-8 items-center px-[100px] max-lg:px-10 max-md:px-4 pt-[110px] max-lg:pt-20 max-md:pt-14 relative text-center w-[820px] max-w-full">
    <div class="flex flex-col gap-4 items-center text-background w-full">
      <h1 class="font-heading text-h1 w-full">Stop losing guests at checkout.</h1>
      <p class="font-body font-normal text-body-lg w-full">
        A modern booking engine built to maximize your direct revenue. Say goodbye to clunky, disconnected checkouts and hi to a seamless flow your guests will love.
      </p>
    </div>
    <div class="flex gap-4 items-start justify-center max-md:w-full">
      <Button href="#" label="Book a demo" icon="images/home/hero/icon-calendar-cta.svg" variant="primary" padding="px-4 py-3" class="max-md:flex-1" />
      <Button href="#" label="Contact us" icon="images/home/hero/icon-chat.svg" variant="secondary" padding="pl-4 pr-5 py-3 max-md:pl-3" class="max-md:flex-1" />
    </div>
  </div>

  <div class="flex justify-center px-[100px] max-lg:px-10 max-md:px-4 pt-16 max-lg:pt-12 max-md:pt-10 pb-[112px] max-lg:pb-14 max-md:pb-10 relative w-full">
    <div class="h-[764px] max-lg:h-[500px] max-md:h-[280px] w-[1240px] max-w-full relative rounded-2xl overflow-hidden shadow-2xl">
      <img
        src={asset('images/booking-engine/hero/screenshot.webp')}
        alt="Hitels booking engine showing available room listings"
        class="absolute inset-0 w-full h-full object-cover object-top"
      />
    </div>
  </div>
</div>
