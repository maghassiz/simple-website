---
import Navigation from '../Navigation';
import Button from '../shared/Button.astro';
import { asset } from '../../lib/cdn';
---

<div class="flex flex-col items-center justify-center min-h-screen overflow-hidden relative w-full bg-gradient-to-b from-[#3d2c99] via-[#654aff] via-50% to-background">
  <div aria-hidden class="absolute inset-0 mix-blend-overlay opacity-40 bg-top-left pointer-events-none" style={`background-image: url('${asset('images/home/hero/hero-bg-texture.webp')}'); background-size: 1920px 1080px;`}></div>

  <div aria-hidden class="absolute bottom-[-213.72px] flex h-[688.717px] items-center justify-center left-[calc(50%+3.05px)] w-[2142.156px] -translate-x-1/2 pointer-events-none">
    <div class="rotate-[-4.09deg]">
      <img src={asset('images/home/hero/decorative-blob.svg')} alt="" class="h-[539.588px] w-[2109.027px] block" />
    </div>
  </div>

  <div class="absolute top-0 inset-x-0 z-10">
    <Navigation client:load />
  </div>

  <div class="flex flex-col gap-8 items-center px-4 relative text-center w-[604px] max-w-full">
    <div class="flex flex-col gap-4 items-center text-background w-full">
      <p class="font-heading font-medium text-[144px] max-lg:text-[104px] max-md:text-[72px] leading-[1.1] tracking-[-0.025em] w-full">404</p>
      <p class="font-body font-normal text-body-lg w-full">The page you are looking for doesn&rsquo;t exist or has been moved.</p>
    </div>
    <Button href="/" label="Back to homepage" variant="primary" padding="px-5 py-3" />
  </div>
</div>
