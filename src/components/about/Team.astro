---
import { asset } from '../../lib/cdn';

// Cards intentionally overflow their container (1558px of cards in a 1240px
// content area, confirmed via real pixel widths in the source) -- a
// horizontal-scroll row like Stories.astro, not a stack. The prev/next
// buttons are a progressive-enhancement scroll nudge on top of native
// touch/trackpad scroll.
const TEAM = [
  {
    name: 'Arnar Hinriksson',
    role: 'Growth and Success',
    email: 'arnar@hitels.is',
    photo: 'images/about/team/arnar.webp',
    inset: 'inset-[-5.36%_-43.01%_-11.01%_-31.12%]',
  },
  {
    name: 'Þórdís',
    role: 'Technology and Customer Success',
    email: 'thordis@hitels.is',
    photo: 'images/about/team/thordis.webp',
    inset: 'inset-[5.36%_-8.39%_-23.81%_-9.79%]',
  },
  {
    name: 'Birgir',
    role: 'Strategy and Consultation',
    email: 'birgir@hitels.is',
    photo: 'images/about/team/birgir.webp',
    inset: 'inset-[4.17%_-27.97%_-51.79%_-19.93%]',
  },
  {
    name: 'Salome',
    role: 'Customer Success & QA',
    email: 'hi@hitels.is',
    photo: 'images/about/team/salome.webp',
    inset: 'inset-[-12.2%_-44.76%_-46.73%_-13.99%]',
  },
  {
    name: 'Bjarki',
    role: 'Designer',
    email: 'hi@hitels.is',
    photo: 'images/about/team/bjarki.webp',
    inset: 'inset-[4.11%_-18.15%_-30.82%_-8.56%]',
  },
];
---

<section class="flex flex-col gap-[72px] max-lg:gap-10 max-md:gap-8 items-start px-[100px] py-[100px] max-lg:px-10 max-lg:py-10 max-md:px-4 max-md:py-10 relative w-full max-w-[1440px] mx-auto bg-background">
  <div data-reveal class="flex flex-col gap-8 items-center text-center px-[211px] max-lg:px-0 relative w-full">
    <h2 class="font-heading text-h3 text-navy w-full">People behind smarter hotel websites</h2>
    <p class="font-body font-normal text-body-md text-gray w-full">
      Most booking engines look like an afterthought. We go further than any competitor to ensure a seamless transition from your website to the checkout. Starting in Figma, we meticulously tailor the typography, colors, and UI components so the engine feels like a natural, premium extension of your brand.
    </p>
  </div>

  <div data-team-carousel class="flex gap-8 items-start w-full overflow-x-auto snap-x snap-mandatory pb-2 scroll-smooth">
    {TEAM.map((member, i) => (
      <div data-reveal style={`--reveal-delay: ${i * 100}ms`} class="flex flex-col gap-6 items-start shrink-0 snap-start w-[286px]">
        <div class="h-[352px] relative rounded-lg shrink-0 w-full overflow-hidden bg-[linear-gradient(171deg,#33258c_1.7%,#654aff_37.3%,#eae8ff_94.3%)]">
          <img src={asset(member.photo)} alt={member.name} class={`absolute ${member.inset} w-full h-full object-cover`} />
        </div>
        <div class="flex flex-col gap-2 items-start w-full">
          <p class="font-heading text-h5 text-navy w-full">{member.name}</p>
          <p class="font-body font-normal text-body-md text-gray w-full">{member.role}</p>
          <p class="font-body font-normal text-body-md text-gray w-full">{member.email}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="flex gap-2.5 items-center">
    <button type="button" aria-label="Scroll team members left" data-direction="-1" class="bg-light-gray flex items-center justify-center rounded-full p-3.5 size-12">
      <img src={asset('images/home/testimonial/arrow-left.svg')} alt="" class="size-5" />
    </button>
    <button type="button" aria-label="Scroll team members right" data-direction="1" class="bg-light-gray flex items-center justify-center rounded-full p-3.5 size-12">
      <img src={asset('images/home/testimonial/arrow-right.svg')} alt="" class="size-5" />
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-team-carousel]').forEach((carousel) => {
    const wrapper = carousel.parentElement;
    if (!wrapper) return;
    const card = carousel.querySelector<HTMLElement>(':scope > div');
    const step = card ? card.offsetWidth + 32 : carousel.clientWidth;

    wrapper.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        carousel.scrollBy({ left: step * Number(button.dataset.direction), behavior: 'smooth' });
      });
    });
  });
</script>
