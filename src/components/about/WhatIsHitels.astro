---
import { asset } from '../../lib/cdn';

const STATS = [
  { color: 'bg-brand', label: 'Direct bookings', value: '120', unit: 'bookings' },
  { color: 'bg-border', label: 'Booking platform', value: '80', unit: 'bookings' },
];

const FEATURES = [
  { title: 'Custom Websites', description: "Unique designs showcasing your hotel's charm" },
  { title: 'Direct Bookings', description: 'Increase revenue through direct reservations' },
  { title: 'Guest Experience', description: 'Seamless, secure booking process' },
  { title: 'Analytics', description: 'Track key metrics for better decisions' },
];
---

<section class="flex gap-[138px] items-center px-[100px] py-[100px] max-lg:flex-col max-lg:gap-10 max-lg:px-10 max-lg:py-10 max-md:px-4 max-md:py-10 relative w-full max-w-[1440px] mx-auto bg-background">
  <div data-reveal="fade" class="w-[604px] h-[520px] max-lg:h-[380px] max-md:h-[280px] max-lg:w-full shrink-0 relative rounded-2xl overflow-hidden bg-[linear-gradient(180deg,#2c1e7e_0%,#4734ff_44.7%,#bcb2ff_95.2%,#fbfbff_131.9%)]">
    <div class="-translate-x-1/2 -translate-y-1/2 absolute bg-background flex flex-col gap-5 items-start left-1/2 top-1/2 pt-5 pb-6 px-6 rounded-2xl w-[367px] max-w-[calc(100%-2.5rem)]">
      <p class="font-heading text-h6 text-navy w-full">Booking Recap</p>
      <div class="flex gap-8 items-center w-full">
        <div class="relative size-[132px] shrink-0 rounded-full" style="background: conic-gradient(var(--color-brand) 0% 60%, var(--color-border) 60% 100%)">
          <span class="absolute top-4 left-5 font-body font-medium text-body-sm text-navy">40%</span>
          <span class="absolute bottom-5 right-6 font-body font-medium text-body-sm text-background">60%</span>
        </div>
        <div class="flex flex-col gap-4 items-start">
          {STATS.map((stat) => (
            <div class="flex flex-col gap-1 items-start">
              <div class="flex gap-2 items-center">
                <span class={`size-2 rounded-full ${stat.color} shrink-0`}></span>
                <p class="font-body font-medium text-body-sm text-navy whitespace-nowrap">{stat.label}</p>
              </div>
              <div class="flex gap-1 items-baseline">
                <p class="font-heading text-h6 text-navy whitespace-nowrap">{stat.value}</p>
                <p class="font-body font-normal text-body-sm text-gray whitespace-nowrap">{stat.unit}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div data-reveal style="--reveal-delay: 120ms" class="flex flex-col gap-8 items-start w-[498px] max-lg:w-full shrink-0">
    <div class="flex flex-col gap-8 items-start w-full">
      <h2 class="font-heading text-h3 text-navy w-full">What is Hitels?</h2>
      <p class="font-body font-normal text-body-md text-gray w-full">
        Hitels is a specialized platform designed to help hotels increase direct bookings by creating custom, scalable websites that enhance guest experiences.
      </p>
    </div>
    <div class="flex flex-col gap-6 items-start w-full">
      {FEATURES.map((feature) => (
        <div class="flex gap-3 items-start w-full">
          <img src={asset('images/home/pricing/icon-check-dark.svg')} alt="" class="size-5 shrink-0 mt-0.5" />
          <div class="flex flex-col gap-1 items-start flex-1">
            <p class="font-body font-medium text-body-md text-navy w-full">{feature.title}</p>
            <p class="font-body font-normal text-body-md text-gray w-full">{feature.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
