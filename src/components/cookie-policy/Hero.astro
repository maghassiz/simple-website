---
import Navigation from '../Navigation';
---

<div class="flex flex-col items-center w-full bg-background">
	<Navigation client:load variant="light" />

	<div class="flex flex-col gap-4 items-center px-[312px] max-lg:px-10 max-md:px-4 pt-20 max-lg:pt-14 max-md:pt-10 relative w-full max-w-[1440px] mx-auto text-center">
		<h1 data-reveal class="font-heading text-h1 max-md:text-h3 text-navy w-full">Cookie Policy</h1>
		<p data-reveal style="--reveal-delay: 100ms" class="font-body font-normal text-body-lg max-md:text-body-md text-gray w-full">
			Last updated April 15, 2024
		</p>
	</div>
</div>
