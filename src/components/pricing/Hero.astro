---
import Navigation from '../Navigation';
---

<div class="flex flex-col items-center w-full bg-background">
  <Navigation client:load variant="light" />

  <div data-reveal class="flex flex-col gap-4 items-center px-[100px] max-lg:px-10 max-md:px-4 pt-16 max-lg:pt-12 max-md:pt-10 pb-16 max-lg:pb-12 max-md:pb-8 relative text-center w-[820px] max-w-full">
    <h1 class="font-heading text-h1 max-md:text-h3 text-navy w-full">Pricing</h1>
    <p class="font-body font-normal text-body-lg text-gray w-full">
      Explore Hitels' flexible pricing plans, designed for hotels of all sizes. Boost direct bookings and online presence with our scalable solutions. Choose your perfect plan today!
    </p>
  </div>
</div>
