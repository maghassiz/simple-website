---
import Navigation from '../Navigation';
import Button from '../shared/Button.astro';
import { asset } from '../../lib/cdn';
---

<div data-hero class="flex flex-col gap-[72px] max-lg:gap-12 items-center overflow-clip relative w-full bg-gradient-to-b from-[#3d2c99] to-[#654aff] to-50%">
  <div aria-hidden class="absolute inset-0 pointer-events-none">
    <div
      class="absolute inset-0 mix-blend-overlay opacity-40 bg-top-left"
      style={`background-image: url('${asset('images/home/hero/hero-bg-texture.webp')}'); background-size: 1920px 1080px;`}
    ></div>
  </div>

  <div aria-hidden class="absolute h-[86.32vh] left-[-323px] top-[366px] w-[146.46vw] pointer-events-none">
    <div class="absolute inset-[-22.4%_-8.25%]">
      <img src={asset('images/booking-engine/hero/decorative-blob.svg')} alt="" class="block max-w-none w-full h-full" />
    </div>
  </div>

  <Navigation client:load />

  <div class="flex flex-col gap-8 items-center px-[100px] max-lg:px-10 max-md:px-4 relative w-full max-w-[1032px] text-center">
    <div data-reveal class="flex flex-col gap-4 items-center text-background w-full">
      <h1 class="font-heading text-h1 max-md:text-h3 w-full">Your hotel is unique. Your website should be too.</h1>
      <p class="font-body font-normal text-body-lg max-md:text-[1.125rem] w-full">
        We design and build award-winning hotel websites from scratch. No templates. Just bespoke, data-driven design engineered to bypass OTAs and capture direct bookings.
      </p>
    </div>
    <div data-reveal style="--reveal-delay: 150ms" class="flex gap-4 items-start justify-center max-md:flex-col max-md:w-full">
      <Button href="/contact-us" label="Contact us" icon="images/home/hero/icon-chat.svg" variant="primary" padding="px-4 py-3" class="max-md:w-full" />
      <Button href="#pricing" label="View pricing" icon="images/custom-website/icon-tag.svg" variant="secondary" class="max-md:w-full" />
    </div>
  </div>

  <div data-reveal="fade" style="--reveal-delay: 250ms" class="relative w-full max-w-[1440px] px-[100px] max-lg:px-10 max-md:px-4 pb-[100px] max-lg:pb-16 max-md:pb-10">
    {/* Matches the Figma "Decorative Background": a solid rectangle starting
        halfway down the image, not the whole section. The gaps baked into the
        collage asset (opaque, no alpha) are colored to match the flat #654aff
        the hero gradient holds below its 50% stop, so this rectangle's hard
        edge only becomes visible once the image itself goes opaque again.
        Full-bleed (w-screen, recentered) so it still reaches the viewport
        edges above max-w-[1440px] instead of leaving purple gutters on large
        desktop; the Hero's own overflow-clip trims any sub-pixel excess. */}
    <div aria-hidden class="absolute left-1/2 -translate-x-1/2 w-screen bottom-0 top-1/2 bg-background -z-10 pointer-events-none"></div>
    {/* Flattened as one collage image per breakpoint (real portfolio site mockups),
        same treatment ProductOfferings uses for its collage — the source has dozens
        of sub-pixel nested elements never meant to be legible/functional on their
        own. Desktop/Tablet/Mobile are separate Figma frames (different crops, not
        just a scaled-down desktop image), so each gets its own exported asset. */}
    <img
      src={asset('images/custom-website/hero/hero-collage.png')}
      alt="Collage of bespoke hotel websites designed and built by Hitels"
      class="w-full rounded-2xl block max-lg:hidden"
    />
    <img
      src={asset('images/custom-website/hero/tablet-hero-collage.png')}
      alt="Collage of bespoke hotel websites designed and built by Hitels"
      class="w-full rounded-2xl hidden max-lg:block max-md:hidden"
    />
    <img
      src={asset('images/custom-website/hero/mobile-hero-collage.png')}
      alt="Collage of bespoke hotel websites designed and built by Hitels"
      class="w-full rounded-2xl hidden max-md:block"
    />
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-b from-transparent to-background rounded-b-2xl pointer-events-none"></div>
  </div>
</div>
