---
import { asset } from '../../lib/cdn';
---

<section class="flex flex-row-reverse items-center gap-[138px] max-lg:flex-col max-lg:gap-12 max-md:gap-8 px-[100px] py-[100px] max-lg:px-10 max-lg:py-10 max-md:px-4 max-md:py-10 relative w-full bg-background">
  <div class="h-[520px] max-lg:h-[464px] max-md:h-[295px] w-[604px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden">
    {/* Source Figma asset for this card is an unrelated typography style-guide
        screenshot (H1-H6 Lorem ipsum) — looks like a placeholder left behind by
        the designer rather than the intended "Custom Design" screenshot. Reproduced
        as exported; flag for a real asset swap once confirmed. */}
    <img
      src={asset('images/custom-website/feature-custom-design.webp')}
      alt="Placeholder typography style guide graphic (pending real asset from design)"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col gap-8 items-start w-full">
    <div class="flex flex-col gap-6 items-start w-full">
      {/* Figma badge shows the unedited default component text ("Full name") for
          this card — inferring a short label consistent with the one card that
          was actually customized (Support -> "Partnership") until real copy lands. */}
      <span class="border border-gray font-body font-medium text-body-sm text-gray rounded px-2.5 pt-0.5 pb-1">Design</span>
      <h2 class="font-heading text-h3 text-navy w-full">Tailored to your identity</h2>
    </div>
    <p class="font-body font-normal text-body-md text-gray w-full">
      We don't do generic. Leveraging the power of Framer, we build everything custom from scratch based on your specific brand guidelines. Your digital presence will be entirely unique, setting you miles apart from competitors relying on rigid WordPress themes.
    </p>
    <a href="#" class="flex gap-3 items-center justify-center rounded-lg">
      <span class="font-body font-medium text-body-md text-navy whitespace-nowrap">Learn more</span>
      <img src={asset('images/home/pricing/icon-arrow-right.svg')} alt="" class="size-5" />
    </a>
  </div>
</section>
