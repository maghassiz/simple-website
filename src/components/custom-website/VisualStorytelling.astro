---
import { asset } from '../../lib/cdn';
---

<section class="flex flex-row-reverse items-center gap-[138px] max-lg:flex-col max-lg:gap-12 max-md:gap-8 px-[100px] py-[100px] max-lg:px-10 max-lg:py-10 max-md:px-4 max-md:py-10 relative w-full bg-background">
  <div class="h-[520px] max-lg:h-[464px] max-md:h-[295px] w-[604px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden bg-light-gray">
    <img
      src={asset('images/custom-website/feature-visual-storytelling.webp')}
      alt="An 'Offers: Midweek Escape' promo card animation on a hotel website"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col gap-8 items-start w-full">
    <div class="flex flex-col gap-6 items-start w-full">
      <span class="border border-gray font-body font-medium text-body-sm text-gray rounded px-2.5 pt-0.5 pb-1">Experience</span>
      <h2 class="font-heading text-h3 text-navy w-full">Immersive Guest Experiences</h2>
    </div>
    <p class="font-body font-normal text-body-md text-gray w-full">
      The guest experience starts long before they arrive at the lobby. Through engaging animations, blazing-fast load times, and compelling visual storytelling, we capture the unique atmosphere of your property and make guests fall in love with your hotel instantly.
    </p>
    <a href="#" class="flex gap-3 items-center justify-center rounded-lg">
      <span class="font-body font-medium text-body-md text-navy whitespace-nowrap">Learn more</span>
      <img src={asset('images/home/pricing/icon-arrow-right.svg')} alt="" class="size-5" />
    </a>
  </div>
</section>
