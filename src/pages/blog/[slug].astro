---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/blog-detail/Hero.astro';
import PostBody from '../../components/blog-detail/PostBody.astro';
import Footer from '../../components/shared/Footer.astro';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)]{ "slug": slug.current }`);
  return posts.map((post: { slug: string }) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;

const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]`,
  { slug }
);

if (!post) {
  return Astro.redirect('/blog');
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.metaDescription || post.shortDescription,
  image: post.imageUrl,
  datePublished: post.publishedAt,
  author: { '@type': 'Organization', name: 'Hitels' },
};
---

<BaseLayout
	title={`${post.metaTitle || post.title} — Hitels`}
	description={post.metaDescription || post.shortDescription}
	ogImage={post.imageUrl}
	ogType="article"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
	</Fragment>
	<header>
		<Hero title={post.title} imageUrl={post.imageUrl} imageAlt={post.imageAlt} />
	</header>
	<main>
		<PostBody body={post.body} />
	</main>
	<Footer />
</BaseLayout>
