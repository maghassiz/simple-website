---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import PartnerLogos from '../components/home/PartnerLogos.astro';
import ProductOfferings from '../components/home/ProductOfferings.astro';
import Testimonial from '../components/home/Testimonial.astro';
import Stories from '../components/home/Stories.astro';
import Benefits from '../components/home/Benefits.astro';
import Pricing from '../components/shared/Pricing.astro';
import AddOns from '../components/home/AddOns.astro';
import Faq from '../components/home/Faq.astro';
import Footer from '../components/shared/Footer.astro';
---

<BaseLayout
	title="Hitels — Turn website visitors into direct bookings"
	description="We build award-winning, bespoke hotel websites and seamless booking engines. No templates, no DIY builders — just a premium digital presence done for you from start to finish."
>
	<header>
		<Hero />
	</header>
	<main>
		<PartnerLogos />
		<ProductOfferings />
		<Testimonial />
		<Stories />
		<Benefits />
		<Pricing />
		<AddOns />
		<Faq />
	</main>
	<Footer />
</BaseLayout>
