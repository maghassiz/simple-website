---
import '../styles/global.css';
import Hero from '../components/home/Hero.astro';
import PartnerLogos from '../components/home/PartnerLogos.astro';
import ProductOfferings from '../components/home/ProductOfferings.astro';
import Testimonial from '../components/home/Testimonial.astro';
import Stories from '../components/home/Stories.astro';
import Benefits from '../components/home/Benefits.astro';
import Pricing from '../components/home/Pricing.astro';
import AddOns from '../components/home/AddOns.astro';
import Faq from '../components/home/Faq.astro';
import Footer from '../components/home/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Hitels — Turn website visitors into direct bookings</title>
	</head>
	<body class="bg-background">
		<header>
			<Hero />
		</header>
		<main>
			<PartnerLogos />
			<ProductOfferings />
			<Testimonial />
			<Stories />
			<Benefits />
			<Pricing />
			<AddOns />
			<Faq />
		</main>
		<Footer />
	</body>
</html>
