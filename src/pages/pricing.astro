---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/pricing/Hero.astro';
import Pricing from '../components/shared/Pricing.astro';
import AddOns from '../components/pricing/AddOns.astro';
import ComparisonTable from '../components/pricing/ComparisonTable.astro';
import Footer from '../components/shared/Footer.astro';
---

<BaseLayout
	title="Pricing — Hitels"
	description="Explore Hitels' flexible pricing plans, designed for hotels of all sizes. Boost direct bookings and online presence with our scalable solutions. Choose your perfect plan today."
>
	<header>
		<Hero />
	</header>
	<main>
		<Pricing showHeading={false} showDetailsLink={false} />
		<AddOns />
		<ComparisonTable />
	</main>
	<Footer />
</BaseLayout>
