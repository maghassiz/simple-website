---
import '../styles/global.css';
import Hero from '../components/custom-website/Hero.astro';
import CustomDesign from '../components/custom-website/CustomDesign.astro';
import DataDriven from '../components/custom-website/DataDriven.astro';
import VisualStorytelling from '../components/custom-website/VisualStorytelling.astro';
import Support from '../components/custom-website/Support.astro';
import Pricing from '../components/home/Pricing.astro';
import Footer from '../components/home/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Custom Website Design — Hitels</title>
	</head>
	<body class="bg-background">
		<header>
			<Hero />
		</header>
		<main>
			<CustomDesign />
			<DataDriven />
			<VisualStorytelling />
			<Support />
			<Pricing />
		</main>
		<Footer />
	</body>
</html>
